# AutoPilot AI - Environment Variables
# Copy to .env if you wish to configure live LLM APIs.
# If left empty, AutoPilot AI automatically operates in offline-safe Deterministic Fallback Mode.

AUTOPILOT_AI_PROVIDER=deterministic_fallback  # deterministic_fallback, gemini, or openai
AUTOPILOT_AI_KEY=
AUTOPILOT_MODEL_NAME=gemini-1.5-pro

# Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
SANDBOX_DIR=./sandbox

# Supabase Cloud Database & Storage (Placeholders)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
